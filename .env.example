# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# Database (Heroku proporciona DATABASE_URL automáticamente)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tu-frontend.vercel.app

# Email Settings (Opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT Settings
JWT_SECRET=your-jwt-secret-key

# Frontend API URL
FRONTEND_URL=https://ecommerce-computadoras.vercel.app

# Vue/Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api
