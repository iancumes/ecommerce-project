# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,tu-railway-url.up.railway.app

# Database
# IMPORTANTE: Si usas Railway, la base de datos se conecta automáticamente
# No necesitas especificar DATABASE_URL - Railway la proporciona
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce

# CORS Settings
# Reemplaza 'https://ecommerce-computadoras.vercel.app' con tu URL real de Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ecommerce-computadoras.vercel.app

# Email Settings (Opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT Settings
JWT_SECRET=your-jwt-secret-key

# Frontend API URL
FRONTEND_URL=https://ecommerce-computadoras.vercel.app

# Vue/Frontend Environment Variables
# Para LOCAL: http://localhost:8000/api
# Para PRODUCCIÓN (Railway): https://tu-railway-url.up.railway.app/api
VITE_API_URL=http://localhost:8000/api
