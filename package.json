{
  "name": "ecommerce-computadoras",
  "version": "1.0.0",
  "description": "E-commerce moderno de venta de computadoras",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend/ecommerce-frontend && npm run dev",
    "dev:backend": "cd backend && source venv/bin/activate && python manage.py runserver",
    "build": "cd frontend/ecommerce-frontend && npm run build",
    "preview": "cd frontend/ecommerce-frontend && npm run preview",
    "lint": "cd frontend/ecommerce-frontend && npm run lint"
  },
  "keywords": [
    "ecommerce",
    "computadoras",
    "vue",
    "django",
    "tailwind"
  ],
  "author": "Tu Nombre",
  "license": "MIT"
}
